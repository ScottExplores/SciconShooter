{
  "name": "scicon-shooter",
  "version": "2.1.0",
  "scripts": {
    "dev": "node --use-system-ca --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js",
    "generate:tailwind": "powershell -ExecutionPolicy Bypass -File tools/generate-tailwind.ps1",
    "build": "vite build && node tools/assert-director-excluded.mjs",
    "preview": "vite preview",
    "director:dev": "npm --prefix director run dev",
    "director:check": "npm --prefix director run check",
    "director:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-scicon-director-shortcuts.ps1",
    "contract:compile": "node tools/compile-contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.6",
    "form-data": "^4.0.6",
    "ox": "^0.14.29",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "solc": "^0.8.36",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.3.4"
  }
}
