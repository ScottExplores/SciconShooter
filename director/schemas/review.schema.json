{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.scicon.director/schemas/review.schema.json",
  "title": "Scicon Director visual review request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "surface", "configVersion", "target", "note", "status", "anchor", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^review-[0-9]{4,}-[0-9a-f]{6}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 999999 },
    "surface": { "enum": ["scorecard", "wave"] },
    "configVersion": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$" },
    "target": { "type": "string", "minLength": 1, "maxLength": 160 },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["open", "resolved"] },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "campaignId", "campaignRevision", "campaignContentHash", "levelId", "levelName", "waveId", "waveName", "elapsedSeconds", "draft"],
      "properties": {
        "source": { "const": "level-editor" },
        "campaignId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "campaignRevision": { "type": "integer", "minimum": 1, "maximum": 999999999 },
        "campaignContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "draftContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "levelId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "levelName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "waveId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "waveName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "eventId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "eventLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "eventKind": { "enum": ["spawn", "boss", "asteroid-belt", "supply-drop", "powerup", "recovery"] },
        "elapsedSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
        "draft": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
    "resolvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" }
  }
}
