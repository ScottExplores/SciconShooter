# Optional: point local dev at deployed APIs instead of Vite middleware.
# VITE_LEADERBOARD_API_URL=https://your-deployment.vercel.app/api/leaderboard
# VITE_WEEKLY_COMPETITIONS_API_URL=https://your-deployment.vercel.app/api/weekly-competitions

# Global leaderboard and verified-run storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_LEADERBOARD_TABLE=scicon_leaderboard
RUN_RECEIPT_SECRET=make-a-different-long-random-secret
# Signs HttpOnly wallet-profile sessions after Base ownership verification.
WALLET_PROFILE_AUTH_SECRET=make-another-long-random-secret-at-least-32-characters

# RSC store payments are pinned in code and database constraints to the public
# founder treasury address. No receiving private key belongs in Vercel.
# Set false only as an emergency kill switch for paid Token packs.
ENABLE_RSC_TOKEN_EXCHANGE=true

# Protected weekly finalization.
CRON_SECRET=make-a-long-random-secret
# ADMIN_SECRET=
# WEEKLY_CHAMPION_WEBHOOK_URL=
# WEEKLY_ALLOCATION_RSC=100

# Autonomous X agent. Keep disabled until the official X developer app,
# spending cap, database migration, and dry-run checks are complete.
X_AUTONOMY_ENABLED=false
# X_ACCOUNT_USER_ID=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# OPENAI_API_KEY=
# X_AGENT_MODEL=gpt-5-mini
# X_AGENT_MAX_REPLIES_PER_DAY=3
# X_AGENT_ORIGINAL_DAYS=Tue,Wed,Thu
# X_AGENT_EVERGREEN_ENABLED=true

# Base app notifications. Keep the dashboard API key server-only.
# BASE_DASHBOARD_API_KEY=
BASE_APP_URL=https://www.sciconshooter.xyz

# Scicon Records contract. Configure after an approved deployment.
# MISSION_RECORD_CONTRACT_ADDRESS=0x...
# MISSION_RECORD_CHAIN_ID=8453
# MINT_AUTHORIZER_PRIVATE_KEY=0x...
# BASE_RPC_URL=https://mainnet.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# VITE_MISSION_RECORD_CONTRACT_ADDRESS=0x...
# VITE_MISSION_RECORD_CHAIN_ID=8453

# Optional sponsored-gas proxy URL. Never expose provider credentials.
# VITE_PAYMASTER_PROXY_URL=/api/paymaster
