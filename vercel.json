{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game-art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/android-privacy.html",
      "destination": "/android-privacy.html"
    },
    {
      "source": "/api/player-runs",
      "destination": "/api/mint-records?route=player-runs"
    },
    {
      "source": "/api/wallet-profile",
      "destination": "/api/mint-records?route=wallet-profile"
    },
    {
      "source": "/api/wallet-purchases",
      "destination": "/api/mint-records?route=wallet-purchases"
    },
    {
      "source": "/api/player-ship-access",
      "destination": "/api/mint-records?route=player-ship-access"
    },
    {
      "source": "/api/continue-payments",
      "destination": "/api/mint-records?route=continue-payments"
    },
    {
      "source": "/api/wallet-token-spends",
      "destination": "/api/mint-records?route=wallet-token-spends"
    },
    {
      "source": "/api/player-reports",
      "destination": "/api/events?route=player-reports"
    },
    {
      "source": "/api/player-ratings",
      "destination": "/api/events?route=player-ratings"
    },
    {
      "source": "/api/researchhub-rfps",
      "destination": "/api/researchhub-proposals?feed=rfps"
    },
    {
      "source": "/api/social-agent",
      "destination": "/api/events?route=social-agent"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
